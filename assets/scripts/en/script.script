        label answer:
            hide choice1
            hide choice2
            hide choice3
            hide choice4
            $ scrawl = 0
            $ question = 0
            if point == 0:
                $ pointotal += 1
            if point == 1:
                $ point = 0
            if area == 123:
                play sound "elevator_shut.wav"
            return

        label hidechoice:
            hide choice1
            hide choice2
            hide choice3
            hide choice4
            return

